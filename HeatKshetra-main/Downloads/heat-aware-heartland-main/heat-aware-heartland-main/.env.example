# FastAPI URL. Start the backend on port 8000 before running the frontend.
VITE_HEAT_RISK_API_URL=http://127.0.0.1:8000

# Firebase web app configuration (public client values; used only by browser push).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
