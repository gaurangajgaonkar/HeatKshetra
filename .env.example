# Local app configuration read by the FastAPI backend.
APP_ENV=development
DATA_MODE=live
DATABASE_URL=sqlite:///./heatkshetra.db

# Open-Meteo public forecast API; no API key is required.
WEATHER_PROVIDER=open-meteo
WEATHER_REFRESH_MINUTES=30

# Required to authorize live alert sends from the dashboard.
ADMIN_API_KEY=replace-with-a-local-secret
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Firebase Cloud Messaging (FCM) browser push. The JSON key stays server-side.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repository/firebase-service-account.json
